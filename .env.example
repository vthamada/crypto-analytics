# Backend

# Admin
ADMIN_TOKEN=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
AUTH_SECRET_KEY=replace-with-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=480

# Banco de dados
DATABASE_URL=sqlite+aiosqlite:///backend/crypto_analytics.db

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=900

# Exchanges
NOVADAX_API_KEY=
NOVADAX_API_SECRET=
MB_API_KEY=
MB_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Scanner
SCAN_INTERVAL_SECONDS=30

# Thresholds padrao
MIN_VOLATILITY_PCT=2.0
MIN_VOLUME_BRL=10000.0
MIN_VOLUME_BRL_SMALL=3000.0
MIN_LIQUIDITY_UNITS=1000.0
MAX_SPREAD_PCT=1.0

# Pesos do score
WEIGHT_VOLATILITY=0.30
WEIGHT_VOLUME=0.25
WEIGHT_LIQUIDITY=0.20
WEIGHT_SPREAD=0.15
WEIGHT_REPETITION=0.10

# Logging
LOG_LEVEL=INFO

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
